{
  "Authentication": {
    "Jwt": {
      "Issuer": "ThinkTechErp.Local",
      "Audience": "ThinkTechErp.Clients",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    },
    "Integration": {
      "Audience": "ThinkTechErp.Integration",
      "AccessTokenMinutes": 10
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
