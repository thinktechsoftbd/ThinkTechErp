{
  "Authentication": {
    "Jwt": {
      "Issuer": "ThinkTechErp.Local",
      "Audience": "ThinkTechErp.Clients",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    },
    "Integration": {
      "Audience": "ThinkTechErp.Integration",
      "AccessTokenMinutes": 10
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "FileStorage": {
    "RootPath": "/srv/storage/public",
    "PublicBaseUrl": "",
    "MaxFileSizeMb": 10,
    "AllowedExtensions": [
      ".jpg", ".jpeg", ".png", ".webp", ".gif", ".avif", ".ico",
      ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".txt"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
