# Copy to /etc/thinktecherp/api.env on the server and fill in the values, then:
#   sudo chown root:root /etc/thinktecherp/api.env
#   sudo chmod 600 /etc/thinktecherp/api.env
# Never commit the filled-in file.

# Generate with: openssl rand -base64 48
Authentication__Jwt__SigningKey=

# Optional: override the values in appsettings.json
#Authentication__Jwt__Issuer=ThinkTechErp
#Authentication__Jwt__Audience=ThinkTechErp.Clients
#Authentication__Jwt__AccessTokenMinutes=15
#Authentication__Jwt__RefreshTokenDays=7

# Server-to-server clients (e.g. one per MediDesk installation), see README.md
# "Integration clients". The ID is letters, digits and underscores.
#Authentication__Integration__Clients__medidesk_example__SecretSha256=<64 hex chars>
#Authentication__Integration__Clients__medidesk_example__ActingUserId=<dedicated user ID>
#Authentication__Integration__Clients__medidesk_example__Scopes__0=organization.sync

# Browser apps allowed to call the API, one origin per index
Cors__AllowedOrigins__0=https://app.example.com

# Serve Swagger UI at /swagger outside Development (e.g. on a staging server only)
#Swagger__Enabled=true

ConnectionStrings__Website="Host=127.0.0.1;Port=5432;Database=thinktecherp;Username=<user>;Password=<password>;Search Path=website"
ConnectionStrings__Sms="Host=127.0.0.1;Port=5432;Database=thinktecherp;Username=<user>;Password=<password>;Search Path=sms"
ConnectionStrings__Security="Host=127.0.0.1;Port=5432;Database=thinktecherp;Username=<user>;Password=<password>;Search Path=security"
# Least-privilege login that is a member of sms_api_runtime
# (ThinkTechErpData/Sql/002_sms_api_permissions.sql)
ConnectionStrings__SmsApi="Host=127.0.0.1;Port=5432;Database=thinktecherp;Username=<sms_api_login>;Password=<password>;Search Path=sms"
